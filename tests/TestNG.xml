<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MobileAutomationSuite" parallel="false" verbose="1">
    <listeners>
        <listener class-name="reports.ExtentReportListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="maintest.LoginTest">
        <classes>
            <class name="maintest.LoginTestSause"/>
        </classes>
    </test>

    <test name="CucumberLoginTest">
        <classes>
            <class name="maintest.RunCucumberTest"/>
        </classes>
    </test>
</suite>
